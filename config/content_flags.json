  "audnex_to_mam": {
    "sSex": {
      "field": "isAdult",
      "value": true,
      "note": "Weak signal - maps to sSex (suggestive), NEVER eSex. Case-insensitive."
    },
    "abridged": {
      "field": "formatType",
      "value": "abridged",
      "note": "Case-insensitive match"
    },
    "lgbt": {
      "field": "genres[].name",
      "match": "contains 'LGBTQ' or 'LGBT'",
      "note": "Case-insensitive. Audnex provides this as genre or tag type."
    }
  },
