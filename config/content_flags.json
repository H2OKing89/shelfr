{
  "_comment": "Content flag mappings from provider signals to MAM flags. Generated from Hardcover API data (Dec 2025, 1089 books analyzed).",
  "_version": "1.0.0",
  "_schema": {
    "version": "1.0",
    "required_fields": [
      "hardcover_to_mam",
      "hardcover_genres_to_mam",
      "audnex_to_mam"
    ],
    "field_types": {
      "hardcover_to_mam": "object<flag: string[]>",
      "hardcover_genres_to_mam": "object<flag: string[]>",
      "audnex_to_mam": "object<flag: object>",
      "_unmapped_warnings": "object<category: string[]>",
      "_design_decisions": "object<key: string>"
    },
    "description": "Mapping configuration for content warning resolution. Consumers should validate structure before parsing."
  },
  "hardcover_to_mam": {
    "cLang": [
      "Strong language",
      "Cursing"
    ],
    "vio": [
      "Violence",
      "Gore",
      "Murder",
      "War",
      "Torture",
      "Blood",
      "Violent imagery",
      "Gun violence",
      "Body horror",
      "Death",
      "Animal death",
      "Child death",
      "Injury/Injury detail",
      "Cannibalism",
      "Genocide",
      "Fire/Fire injury",
      "Kidnapping",
      "Slavery",
      "Confinement"
    ],
    "sSex": [
      "Sexual content",
      "Spicy",
      "Sexual scenes"
    ],
    "eSex": [
      "Rape",
      "Sexual assault",
      "Sexual violence",
      "Sexual harassment",
      "Adult/minor relationship"
    ],
    "lgbt": [
      "LGBTQ",
      "LGBT"
    ]
  },
  "hardcover_genres_to_mam": {
    "lgbt": [
      "LGBTQ",
      "LGBT",
      "Queer Fiction",
      "Gay Fiction",
      "Lesbian Fiction"
    ]
  },
  "audnex_to_mam": {
    "sSex": {
      "field": "isAdult",
      "value": true,
      "note": "Weak signal - maps to sSex (suggestive), NEVER eSex. Case-insensitive."
    },
    "abridged": {
      "field": "formatType",
      "value": "abridged",
      "note": "Case-insensitive match"
    },
    "lgbt": {
      "field": "genres[].name",
      "contains_any": [
        "LGBTQ",
        "LGBT"
      ],
      "case_insensitive": true,
      "note": "Audnex provides this as genre or tag type."
    }
  },
  "_unmapped_warnings": {
    "_comment": "Hardcover warnings observed but not mapped to MAM flags (no clear MAM equivalent)",
    "emotional_not_content_flags": [
      "Grief",
      "Depression",
      "Emotional abuse",
      "Toxic friendship",
      "Toxic relationship",
      "Misogyny",
      "Xenophobia",
      "Racism",
      "Ableism",
      "Classism",
      "Colonisation",
      "Hate crime",
      "Bullying",
      "Stalking"
    ],
    "medical_not_content_flags": [
      "Vomit",
      "Medical content",
      "Cancer",
      "Infertility",
      "Abortion",
      "Miscarriage",
      "Suicidal thoughts",
      "Suicide"
    ],
    "substance_not_content_flags": [
      "Drug use",
      "Drug abuse",
      "Alcohol",
      "Alcohol consumption",
      "Addiction"
    ],
    "death_overly_specific": [
      "Death of a brother",
      "Death of parent"
    ]
  },
  "_design_decisions": {
    "sexual_violence_to_eSex": "Sexual assault, Rape -> eSex (not vio). The sexual nature is primary concern for MAM filtering.",
    "death_to_vio": "Generic 'death', 'animal death', 'child death' -> vio. Specific relationship-based warnings (e.g., 'Death of parent') are intentionally unmapped as overly specific.",
    "audnex_never_eSex": "isAdult=true -> sSex only. Too many false positives for explicit upgrade.",
    "case_insensitive": "All string matching is case-insensitive."
  }
}
